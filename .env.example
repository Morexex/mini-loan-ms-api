APP_NAME="Mini Loan MS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Use localhost (not 127.0.0.1) so SPA CSRF cookies work with the Vite origin.
# Default port 8000; use another if taken: php artisan serve --host=localhost --port=8001
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL — preferred for assessment/demo) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mini_loan_ms
DB_USERNAME=root
DB_PASSWORD=
#
# Create DB once:
#   mysql -h 127.0.0.1 -u root -e "CREATE DATABASE IF NOT EXISTS mini_loan_ms CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#
# Optional sqlite-only smoke path (not for demo):
# DB_CONNECTION=sqlite
# (and: touch database/database.sqlite)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# --- SPA (Vue on Vite) ---
# Must match the browser origin used for `npm run dev`.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Prefer redis when available: QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ops@miniloan.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Bootstrap ---
# cp .env.example .env
# php artisan key:generate
# Create MySQL database mini_loan_ms (see above)
# php artisan migrate:fresh --seed
# php artisan serve                # or: php artisan serve --port=8001
#
# Seeded ops user:
#   email: ops@miniloan.test
#   password: password

# --- Daraja ---
# true  = FakeDarajaGateway (deterministic local/CI; no Safaricom calls)
# false = SandboxDarajaGateway (fill credentials below for live sandbox demos)
DARAJA_FAKE=true
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=
DARAJA_B2C_RESULT_URL="${APP_URL}/webhooks/daraja/b2c"
DARAJA_B2C_TIMEOUT_URL="${APP_URL}/webhooks/daraja/b2c"
DARAJA_STK_CALLBACK_URL="${APP_URL}/webhooks/daraja/stk"

# Payment Intent TTL (minutes) before scheduler may expire it
PAYMENT_INTENT_TTL_MINUTES=15

# SMS forwarder secondary evidence webhook
# Header: X-Sms-Forwarder-Secret: <this value>
SMS_FORWARDER_WEBHOOK_SECRET=local-sms-secret
